# Database
DATABASE_URL=REPLACE_ME
DATABASE_APP_URL=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME_32_CHARS
TOKEN_ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS

# Redis
REDIS_URL=REPLACE_ME

# Anthropic
ANTHROPIC_API_KEY=REPLACE_ME

# Supabase Auth
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
# Local API JWT verification is disabled (Supabase /auth/v1/user introspection is used per request).
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_SECRET=REPLACE_ME

# Gmail OAuth
GMAIL_CLIENT_ID=REPLACE_ME
GMAIL_CLIENT_SECRET=REPLACE_ME
# Must exactly match one Google Cloud "Authorized redirect URI" entry.
GMAIL_REDIRECT_URI=http://localhost:3000/api/v1/email-connections/gmail/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# App
NODE_ENV=development
PORT=3000
# Web app origin used after OAuth callback.
WEB_APP_URL=http://localhost:5173
JWT_SECRET=REPLACE_ME
SENTRY_DSN=REPLACE_ME
MAILTRAP_USER=REPLACE_ME
MAILTRAP_PASS=REPLACE_ME
